#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <Keyboard.h>
#include <RotaryEncoder.h>

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET    -1 
#define SCREEN_ADDRESS 0x3C 

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

// --- PIN BELEGUNG ---
const int btnPins[] = {29, 28, 0, 1, 2, 4}; 
const int modPin = 3;                       
const int encPinA = 6;
const int encPinB = 7;
const int SDA_PIN = 26;
const int SCL_PIN = 27;

RotaryEncoder encoder(encPinA, encPinB, RotaryEncoder::LatchMode::TWO03);
int lastPos = 0;
int currentMode = 1;
unsigned long lastActionTime = 0;
const unsigned long displayHoldTime = 1000;
bool onMainScreen = true;

const int debounceDelay = 50; 
unsigned long lastBtnTimes[] = {0, 0, 0, 0, 0, 0};
unsigned long lastModTime = 0; // Für Entprellung des Umschalters
int lastBtnStates[] = {HIGH, HIGH, HIGH, HIGH, HIGH, HIGH};
int lastModState = HIGH;

// --- GRAFIK-FUNKTIONEN ---

void bootAnimation() {
  display.clearDisplay();
  
  // Rahmen zeichnen
  display.drawRect(0, 0, 128, 64, SSD1306_WHITE);
  
  display.setTextSize(2);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(22, 15);
  display.println("AckuPad");
  display.display();
  delay(300);

  // Ladebalken (Rahmen)
  display.drawRect(14, 40, 100, 10, SSD1306_WHITE);
  
  // Ladebalken füllen
  for(int x=0; x<=96; x+=4) {
    display.fillRect(16, 42, x, 6, SSD1306_WHITE);
    display.display();
    delay(30);
  }
  delay(500);
}

void showModeScreen() {
  display.clearDisplay();
  
  // Oberer Balken mit "AckuPad"
  display.fillRect(0, 0, 128, 22, SSD1306_WHITE);
  display.setTextColor(SSD1306_BLACK);
  display.setTextSize(2);
  display.setCursor(20, 4);
  display.print("AckuPad");
  
  // "Modus:" Text (Größer)
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(2); 
  display.setCursor(10, 35);
  display.print("Modus:");
  
  // Große Modus-Zahl daneben
  display.setTextSize(4);
  display.setCursor(90, 30);
  display.print(currentMode);
  
  // Deko-Linie unten
  display.drawFastHLine(10, 60, 108, SSD1306_WHITE);
  
  display.display();
  onMainScreen = true;
}

void showAction(String title, String key) {
  display.clearDisplay();
  display.drawRoundRect(0, 0, 128, 64, 8, SSD1306_WHITE);
  
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(12, 12);
  display.println(title);
  
  int16_t x1, y1;
  uint16_t w, h;
  display.setTextSize(2);
  display.getTextBounds(key, 0, 0, &x1, &y1, &w, &h);
  display.setCursor((128 - w) / 2, 35);
  display.println(key);
  
  display.display();
  onMainScreen = false;
}

// --- LOGIK ---

void extraCtrlTaps() {
  for(int i=0; i<3; i++) {
    Keyboard.press(KEY_LEFT_CTRL);
    delay(30);
    Keyboard.release(KEY_LEFT_CTRL);
    delay(30);
  }
}

void setup() {
  Wire.setSDA(SDA_PIN);
  Wire.setSCL(SCL_PIN);
  Wire.begin();
  
  for (int i = 0; i < 6; i++) pinMode(btnPins[i], INPUT_PULLUP);
  pinMode(modPin, INPUT_PULLUP);
  
  if(!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3D)) for(;;); 
  }
  
  bootAnimation();
  Keyboard.begin();
  showModeScreen();
}

void loop() {
  unsigned long currentTime = millis();
  bool anyButtonPressed = false;

  // 1. Encoder
  encoder.tick();
  int newPos = encoder.getPosition();
  if (newPos != lastPos) {
    if (newPos > lastPos) { Keyboard.write(KEY_F13); showAction("VOL UP", "F13"); }
    else { Keyboard.write(KEY_F14); showAction("VOL DOWN", "F14"); }
    lastPos = newPos;
    lastActionTime = currentTime;
  }

  // 2. Modus Wechsler (MIT ENTPRELLUNG)
  int modState = digitalRead(modPin);
  if (modState == LOW && lastModState == HIGH) {
    // Prüfen, ob genug Zeit seit dem letzten Umschalten vergangen ist
    if (currentTime - lastModTime > 200) { // 200ms Sperre gegen mechanisches Prellen
      currentMode = (currentMode == 1) ? 2 : 1;
      showModeScreen();
      lastModTime = currentTime;
    }
  }
  lastModState = modState;

  // 3. Tasten 1-6
  for (int i = 0; i < 6; i++) {
    int btnState = digitalRead(btnPins[i]);
    
    if (btnState == LOW && lastBtnStates[i] == HIGH && (currentTime - lastBtnTimes[i] > debounceDelay)) {
      String label = "";
      if (i == 0 || i == 1) { 
        if (currentMode == 1) {
          Keyboard.press(KEY_LEFT_CTRL);
          Keyboard.press(i == 0 ? KEY_F13 : KEY_F14); 
          label = i == 0 ? "CTRL+F13" : "CTRL+F14";
        } else {
          Keyboard.press(i == 0 ? KEY_F19 : KEY_F20);
          label = i == 0 ? "F19" : "F20";
        }
      } else {
        int fKey = (currentMode == 1) ? (KEY_F15 + (i - 2)) : (KEY_F21 + (i - 2));
        Keyboard.press(fKey);
        label = "F" + String((currentMode == 1 ? 15 : 21) + (i - 2));
      }
      showAction("TASTE " + String(i+1), label);
      lastBtnTimes[i] = currentTime;
    }

    if (btnState == LOW) {
      anyButtonPressed = true;
      lastActionTime = currentTime; 
    }

    if (btnState == HIGH && lastBtnStates[i] == LOW) {
      Keyboard.releaseAll();
      if (currentMode == 1 && (i == 0 || i == 1)) {
        extraCtrlTaps();
      }
      lastActionTime = currentTime; 
    }
    lastBtnStates[i] = btnState;
  }

  if (!onMainScreen && !anyButtonPressed && (currentTime - lastActionTime > displayHoldTime)) {
    showModeScreen();
  }
}
