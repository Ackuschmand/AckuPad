; --- AUSWAHLFENSTER (STYLISCH) ---
ShowMenu:
    StringSplit, KeyData, A_GuiControl, _
    CurrentModus := KeyData1, CurrentButton := KeyData2
    IsEncoder := (CurrentButton = "Enc")
    
    Gui, Menu:New, -Caption +Border +AlwaysOnTop +Owner1
    Gui, Menu:Color, %Col_Panel%
    Gui, Menu:Font, S11 Bold C%Col_Accent%, Segoe UI Variable
    Gui, Menu:Add, Text, w260 Center c%Col_Accent%, %CurrentButton%
    
    if (IsEncoder) {
        IniRead, ActR, %SettingsFile%, %CurrentModus%, %CurrentButton%R, NoAction
        IniRead, ActL, %SettingsFile%, %CurrentModus%, %CurrentButton%L, NoAction
        Gui, Menu:Font, S9 Normal C%Col_SubText%
        Gui, Menu:Add, Text, ,  RECHTS (Ist: %ActR%)
        Gui, Menu:Add, ListBox, vActionR w260 r6 Background%Col_BG% Color%Col_Text%, %ActionList%
        Gui, Menu:Add, Text, ,  LINKS (Ist: %ActL%)
        Gui, Menu:Add, ListBox, vActionL w260 r6 Background%Col_BG% Color%Col_Text%, %ActionList%
    } else {
        IniRead, CurrentAct, %SettingsFile%, %CurrentModus%, %CurrentButton%, NoAction
        Gui, Menu:Font, S9 Normal C%Col_SubText%
        Gui, Menu:Add, Text, w260 Center, Aktuelle Aktion: %CurrentAct%
        Gui, Menu:Add, ListBox, vActionSingle w260 r12 Background%Col_BG% Color%Col_Text%, %ActionList%
    }
    Gui, Menu:Add, Text, , 
    Gui, Menu:Add, Button, w120 h35 x10 gSaveAction Default,  SAVE
    Gui, Menu:Add, Button, w120 h35 x140 yp gMenuGuiClose,  CANCEL
    Gui, Menu:Show
return

; ... (Logik-Teil bleibt identisch) ...
SaveAction:
    Gui, Menu:Submit
    if (IsEncoder) {
        FinalR := ParseAction(ActionR), FinalL := ParseAction(ActionL)
        if (FinalR != "")
            IniWrite, %FinalR%, %SettingsFile%, %CurrentModus%, %CurrentButton%R
        if (FinalL != "")
            IniWrite, %FinalL%, %SettingsFile%, %CurrentModus%, %CurrentButton%L
    } else {
        FinalAction := ParseAction(ActionSingle)
        if (FinalAction != "")
            IniWrite, %FinalAction%, %SettingsFile%, %CurrentModus%, %CurrentButton%
    }
    Gui, Menu:Destroy
return

ParseAction(ActionRaw) {
    if (ActionRaw = "Eigene Eingabe...") {
        InputBox, Custom, Eigene Aktion, Gib AHK-Code ein:, , 240, 150
        return (ErrorLevel) ? "" : Custom
    } else if (ActionRaw = "Browser öffnen")
        return "run chrome.exe"
    RegExMatch(ActionRaw, "\((.*)\)", Match)
    return Match1
}

MenuGuiClose:
    Gui, Menu:Destroy
return

ReloadScript:
    Reload
return

GuiClose:
ExitApp

