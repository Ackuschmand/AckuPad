F21::Go("Modus2", "T1")
F22::Go("Modus2", "T2")
F23::Go("Modus2", "T3")
F24::Go("Modus2", "T4")

Go(m, k) {
    global SettingsFile
    IniRead, act, %SettingsFile%, %m%, %k%, NoAction
    if (act != "NoAction") {
        if (InStr(act, "run "))
            Run, % SubStr(act, 5)
        else
            SendInput, %act%
    }
}
